# ============================================================
# MUSIC 221 - Déploiement
# Copie ce fichier en `.env.deploy` puis renseigne les valeurs.
# Les variables runtime de l'application peuvent venir de `.env`
# ou d'un fichier indiqué par `APP_ENV_FILE`.
# ============================================================

# --- SSH / serveur distant ---
SSH_HOST=your-server.example.com
SSH_USER=deploy
SSH_PORT=22
SSH_KEY=~/.ssh/id_rsa

# --- Docker Hub / image ---
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-token
IMAGE_NAME=your-dockerhub-username/music221
IMAGE_TAG=latest

# --- Conteneur / ports / URL ---
CONTAINER_NAME=music221-container
HOST_PORT=80
CONTAINER_PORT=3000
APP_URL=http://your-server.example.com
HEALTH_PATH=/health
FALLBACK_HEALTH_PATH=/

# Fichier runtime à envoyer au serveur si présent.
# Par défaut, le script essaie `.env` à la racine du projet.
APP_ENV_FILE=.env

# --- Runtime applicatif (optionnel si APP_ENV_FILE existe) ---
# DATABASE_URL=postgresql://user:password@host:5432/music221
# DIRECT_URL=postgresql://user:password@host:5432/music221
# NODE_ENV=production
# PORT=3000

# --- Notifications Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
